{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@agentmonitors/cli",
  "namedInputs": {
    "repoFixtureInputs": [
      "{workspaceRoot}/agent-plugins/agentmonitors/**/*",
      "{workspaceRoot}/scripts/owned-test-group.mjs",
      "{workspaceRoot}/scripts/owned-worker-terminated.mjs"
    ]
  },
  "targets": {
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "default",
        "^production",
        "testIsolation",
        "testEnvironment",
        "repoFixtureInputs"
      ]
    },
    "test:serial": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "default",
        "^production",
        "testIsolation",
        "testEnvironment",
        "repoFixtureInputs"
      ]
    },
    "test:docker-smoke": {
      "cache": false
    }
  }
}
