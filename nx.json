{
  "$schema": "https://nx.dev/nx-schema.json",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/api-extractor.base.json",
      "{workspaceRoot}/api-extractor.build.json"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/vitest.config.ts",
      "!{projectRoot}/**/__integration__/**"
    ],
    "testIsolation": ["{workspaceRoot}/scripts/test-isolation/**/*"],
    "testEnvironment": [
      "{workspaceRoot}/scripts/nx-test-environment.mjs",
      {
        "runtime": "node scripts/nx-test-environment.mjs"
      }
    ],
    "dockerEnvironment": [
      "{workspaceRoot}/scripts/nx-test-environment.mjs",
      {
        "runtime": "node scripts/nx-test-environment.mjs --docker"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^production", "testIsolation", "testEnvironment"]
    },
    "test:serial": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^production", "testIsolation", "dockerEnvironment"]
    },
    "clean": {
      "cache": false
    },
    "check:api-report": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/api-extractor.report.json"
      ],
      "outputs": ["{projectRoot}/temp"]
    },
    "fix:api-report": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
